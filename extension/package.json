{
  "name": "prodigy-origin-extension",
  "version": "4.5.0",
  "private": true,
  "description": "Plasmo-based Play Origin browser extension",
  "scripts": {
    "menu": "pnpm --dir ../originGUI build",
    "dev": "pnpm run menu && plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "pnpm run menu && plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "pnpm run menu && plasmo package",
    "package:firefox": "plasmo package --target=firefox-mv3",
    "typecheck": "pnpm run menu && tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "plasmo": "^0.90.5",
    "typescript": "^7.0.2"
  },
  "manifest": {
    "name": "Play Origin | Math game Mod Hack",
    "description": "The ultimate open-source mod loader for online math games.",
    "author": "ProdigyPXP",
    "permissions": [
      "declarativeNetRequest"
    ],
    "web_accessible_resources": [
      {
        "resources": ["assets/origin-bg.png", "assets/origin-logo.png"],
        "matches": ["*://*.prodigygame.com/*"]
      }
    ],
    "host_permissions": [
      "*://*.prodigygame.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "phex@prodigypxp.com"
      }
    }
  }
}
